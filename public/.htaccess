# /inmo/public/.htaccess
<IfModule mod_rewrite.c>
    Options -Multiviews
    RewriteEngine On
    RewriteBase /inmo/public/

    # Si es un archivo o directorio existente, entrégalo tal cual
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Todo lo demás pasa por index.php
    RewriteRule ^ index.php [L]
</IfModule>
